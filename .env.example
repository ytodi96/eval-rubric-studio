# Copy this file to .env and fill in your key. Never commit .env or put keys in code.

# Which AI provider the Studio uses: openai (default) or anthropic.
EVALSTUDIO_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   (only if a provider below is anthropic)

# Where projects, runs and grades are stored. Default: ./data (gitignored).
# DATA_DIR=./data

# Model per role. Leave these out to use the defaults (only the judge gets the strong model):
#   openai:    generator and improver gpt-6.1-terra, judge gpt-6.1-sol
#   anthropic: generator and improver claude-sonnet-5-5, judge claude-opus-5-5
# Each role can also use a different provider, e.g. a Claude judge for an OpenAI target:
#   EVALSTUDIO_JUDGE_PROVIDER=anthropic
#   EVALSTUDIO_JUDGE_MODEL=claude-opus-5-5
# EVALSTUDIO_GENERATOR_MODEL=gpt-6.1-terra # clarifying questions, use-case card, test cases, rubrics
# EVALSTUDIO_JUDGE_MODEL=gpt-6.1-sol       # grades responses; keep this at least as strong as the target
# EVALSTUDIO_IMPROVER_MODEL=gpt-6.1-terra  # suggests prompt / rubric changes
# Reasoning effort per role: low, medium (default) or high. Higher is slower and costs more.
# EVALSTUDIO_JUDGE_EFFORT=medium
# Most output tokens per call (reasoning included): generator 16000, judge 4000, improver 8000.
# EVALSTUDIO_JUDGE_MAX_TOKENS=4000

# Hard spending cap per run, in US dollars. A run estimated to cost more is refused, and a run
# that reaches it while running stops cleanly.
# EVALSTUDIO_SPEND_CAP_USD=2

# A test case passes when its weighted score is at least this (0-1) and no must-pass criterion failed.
# EVALSTUDIO_PASS_MARK=0.8
